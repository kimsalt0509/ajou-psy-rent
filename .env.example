# 이 파일을 .env.local 로 복사해 값을 채우세요. (Vercel에는 프로젝트 설정 → Environment Variables 에 입력)

# ─── 관리자 ────────────────────────────────────────────────────────────────────
# 관리자 비밀번호 (필수, 기본값 없음). 바꾸면 모든 관리자 세션이 로그아웃됩니다.
ADMIN_PIN=여기에-추측하기-어려운-비밀번호
# 관리자 세션 서명 키 (권장). `openssl rand -base64 32` 로 생성. 비우면 Firebase 개인키에서 유도
ADMIN_SESSION_SECRET=

# ─── Vercel Cron (필수) ────────────────────────────────────────────────────────
# 없으면 연체 알림 크론이 실행되지 않습니다. `openssl rand -hex 32` 로 생성
CRON_SECRET=

# ─── 로그인 제한 ───────────────────────────────────────────────────────────────
# 학교 계정만 허용하려면 둘 다 ajou.ac.kr 로 설정 (비우면 모든 Google 계정 허용)
ALLOWED_EMAIL_DOMAIN=
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=

# ─── 개인정보 보관 기간 ─────────────────────────────────────────────────────────
# 반납 완료 후 N일이 지난 기록·사진을 매일 자동 삭제. 비우거나 0이면 삭제 안 함 (권장: 180)
RETENTION_DAYS=180

# ─── 담당자 연락처 (사이트 하단·메일에 표시) ────────────────────────────────────
NEXT_PUBLIC_CONTACT_LABEL=심리학과 부학생회장 홍길동
NEXT_PUBLIC_CONTACT_PHONE=010-0000-0000

# ─── 메일 (Gmail 앱 비밀번호) ───────────────────────────────────────────────────
GMAIL_USER=
GMAIL_APP_PASSWORD=
# 알림 받을 관리자 메일 (쉼표로 여러 개)
ADMIN_EMAIL=
# scripts/test-late-return-email.mjs 테스트 수신 주소
TEST_EMAIL_TO=

# ─── Firebase Admin SDK (서버 전용, NEXT_PUBLIC_ 없음) ──────────────────────────
# Firebase Console → 프로젝트 설정 → 서비스 계정 → 새 비공개 키 생성
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app

# ─── Firebase Client SDK (브라우저 공개 키, NEXT_PUBLIC_ 붙임) ──────────────────
# Firebase Console → 프로젝트 설정 → 앱 추가 (웹) → 구성 값 복사
NEXT_PUBLIC_FIREBASE_API_KEY=AIza...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef
